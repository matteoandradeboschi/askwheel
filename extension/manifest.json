{
  "manifest_version": 3,
  "name": "AskWheel PAA",
  "version": "0.1.0",
  "description": "Brings Google's People Also Ask into AskWheel automatically on every search.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://www.google.com/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["https://askwheel.askwheel.workers.dev/*"],
    "js": ["site.js"],
    "run_at": "document_start"
  }],
  "browser_specific_settings": {
    "gecko": { "id": "askwheel-paa@askwheel", "strict_min_version": "121.0", "data_collection_permissions": { "required": ["none"] } }
  }
}
